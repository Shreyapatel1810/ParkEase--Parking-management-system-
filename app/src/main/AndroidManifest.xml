<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== Permissions ===== -->
    <!-- Firebase needs internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Check whether the phone is online (show "No internet" banner) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Staff QR ticket scanner (asked at runtime in ScanTicketActivity, Step 13) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Booking notifications on Android 13+ (asked at runtime, used in Step 12) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-schedule booking reminders after the phone restarts (Step 12) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional: approximate location to sort parking by distance (Step 7, asked at runtime) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Step 13: CAMERA (declared above) is used only by the staff QR scanner and is asked
         for at runtime in ScanTicketActivity. The camera is optional, so phones without
         one can still install the app; autofocus helps reading QR codes. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".ParkEaseApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ParkEase"
        tools:targetApi="35">

        <!-- Step 4: Splash is the launcher (first screen when the app icon is tapped) -->
        <activity
            android:name=".ui.common.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ParkEase.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Step 4: three intro pages, shown only until completed once -->
        <activity
            android:name=".ui.common.OnboardingActivity"
            android:exported="false" />

        <!-- Step 5: authentication (adjustResize keeps fields above the keyboard) -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Step 7: customer dashboard with bottom navigation (Home, Explore, Bookings, Favourites, Profile) -->
        <activity
            android:name=".ui.customer.CustomerMainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan|stateHidden" />
        <activity
            android:name=".ui.customer.location.LocationDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.customer.notification.NotificationsActivity"
            android:exported="false" />

        <!-- Step 10: vehicle management -->
        <activity
            android:name=".ui.customer.vehicle.VehiclesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.customer.vehicle.AddEditVehicleActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Step 9: interactive slot layout + server-verified reservation -->
        <activity
            android:name=".ui.customer.booking.SlotSelectionActivity"
            android:exported="false" />

        <!-- Step 11: booking summary, confirm, cancel -->
        <activity
            android:name=".ui.customer.booking.BookingSummaryActivity"
            android:exported="false" />

        <!-- Step 12: simulated payments -->
        <activity
            android:name=".ui.customer.payment.PaymentActivity"
            android:exported="false" />
        <activity
            android:name=".ui.customer.payment.PaymentResultActivity"
            android:exported="false" />
        <activity
            android:name=".ui.customer.payment.PaymentHistoryActivity"
            android:exported="false" />

        <!-- Step 13: QR ticket (customer) and gate scanner (staff) -->
        <activity
            android:name=".ui.customer.ticket.TicketActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.scan.ScanTicketActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:name=".ui.admin.scan.VerifyTicketActivity"
            android:exported="false" />

        <!-- Step 5: admin dashboard (placeholder until the admin module) -->
        <activity
            android:name=".ui.admin.AdminMainActivity"
            android:exported="false" />

        <!-- Step 6: profile management (customers and admins) -->
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.profile.ChangePasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Step 3: Design System preview (developer screen) -->
        <activity
            android:name=".ui.preview.DesignSystemActivity"
            android:exported="false" />

        <!-- Step 2 setup check (opened from the Design System screen) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>

</manifest>
