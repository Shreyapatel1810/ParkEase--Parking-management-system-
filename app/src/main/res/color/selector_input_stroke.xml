<?xml version="1.0" encoding="utf-8"?>
<!-- Text field border: teal when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/brand_secondary" />
    <item android:state_hovered="true" android:color="@color/text_secondary" />
    <item android:state_enabled="false" android:color="@color/stroke" android:alpha="0.5" />
    <item android:color="@color/stroke" />
</selector>
