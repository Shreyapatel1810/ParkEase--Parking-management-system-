<?xml version="1.0" encoding="utf-8"?>
<!-- One selectable payment method (Step 12). Selected state is set in PaymentActivity. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    style="@style/Widget.ParkEase.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    app:checkedIcon="@null">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <FrameLayout
            android:layout_width="@dimen/icon_container"
            android:layout_height="@dimen/icon_container"
            android:background="@drawable/bg_icon_circle"
            android:backgroundTint="@color/brand_secondary_container">

            <ImageView
                android:id="@+id/imgIcon"
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/brand_on_secondary_container"
                tools:src="@drawable/ic_upi" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/Widget.ParkEase.Text.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="UPI (demo)" />

            <TextView
                android:id="@+id/tvSubtitle"
                style="@style/Widget.ParkEase.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Simulated UPI app – no UPI ID or PIN needed" />
        </LinearLayout>

        <!-- Display only: the whole card handles the click -->
        <RadioButton
            android:id="@+id/radio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            app:buttonTint="@color/brand_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
