<?xml version="1.0" encoding="utf-8"?>
<!-- Small location chip-card for the Home "Favourites" and "Recently visited" rows. Used by LocationAdapter. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <FrameLayout
            android:layout_width="@dimen/icon_container"
            android:layout_height="@dimen/icon_container"
            android:background="@drawable/bg_icon_circle"
            android:backgroundTint="@color/brand_secondary_container">

            <ImageView
                android:id="@+id/imgIcon"
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_location"
                app:tint="@color/brand_secondary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                style="@style/Widget.ParkEase.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_medium"
                android:maxLines="1"
                tools:text="Riverfront Plaza Parking" />

            <TextView
                android:id="@+id/tvSubtitle"
                style="@style/Widget.ParkEase.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="23 free · from ₹15/hr" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
