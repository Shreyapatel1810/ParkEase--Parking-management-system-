<?xml version="1.0" encoding="utf-8"?>
<!-- Notification inbox. Java: ui/customer/notification/NotificationsActivity.java -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    tools:context=".ui.customer.notification.NotificationsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <include
            android:id="@+id/header"
            layout="@layout/layout_header_toolbar" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ParkEase.Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/header_overlap"
            android:layout_marginBottom="@dimen/screen_padding"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingVertical="@dimen/space_sm"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_notification" />

                <com.parkease.app.ui.components.StateView
                    android:id="@+id/stateView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <include
        android:id="@+id/statusBarScrim"
        layout="@layout/view_status_bar_scrim" />
</FrameLayout>
