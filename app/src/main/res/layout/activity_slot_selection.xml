<?xml version="1.0" encoding="utf-8"?>
<!--
    Interactive parking layout (Step 9). Java: ui/customer/booking/SlotSelectionActivity.java
    Header → time & vehicle card → legend + floors → slot grid → selected slot panel.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    tools:context=".ui.customer.booking.SlotSelectionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <include
            android:id="@+id/header"
            layout="@layout/layout_header_toolbar" />

        <!-- ================= When & what ================= -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ParkEase.Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/header_overlap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <!-- Your vehicle (Step 10): chips are created in code from My Vehicles -->
                <TextView
                    style="@style/Widget.ParkEase.Text.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/booking_your_vehicle" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipVehicles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDate"
                        style="@style/Widget.ParkEase.Button.Secondary.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:layout_weight="1"
                        android:paddingHorizontal="@dimen/space_xs"
                        android:textSize="@dimen/text_caption"
                        app:icon="@drawable/ic_bookings"
                        app:iconSize="@dimen/icon_xs"
                        tools:text="Today" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTime"
                        style="@style/Widget.ParkEase.Button.Secondary.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:layout_weight="1"
                        android:paddingHorizontal="@dimen/space_xs"
                        android:textSize="@dimen/text_caption"
                        app:icon="@drawable/ic_clock"
                        app:iconSize="@dimen/icon_xs"
                        tools:text="4:30 PM" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDuration"
                        style="@style/Widget.ParkEase.Button.Secondary.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingHorizontal="@dimen/space_xs"
                        android:textSize="@dimen/text_caption"
                        tools:text="2 h" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTimeError"
                    style="@style/Widget.ParkEase.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textColor="@color/error"
                    android:visibility="gone"
                    tools:text="@string/time_err_hours"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= Legend ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.ParkEase.Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="@dimen/space_xs"
                android:gravity="center_vertical"
                android:text="@string/status_available"
                app:drawableStartCompat="@drawable/bg_status_dot"
                app:drawableTint="@color/slot_available" />

            <TextView
                style="@style/Widget.ParkEase.Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="@dimen/space_xs"
                android:gravity="center_vertical"
                android:text="@string/status_reserved"
                app:drawableStartCompat="@drawable/bg_status_dot"
                app:drawableTint="@color/slot_reserved" />

            <TextView
                style="@style/Widget.ParkEase.Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="@dimen/space_xs"
                android:gravity="center_vertical"
                android:text="@string/status_occupied"
                app:drawableStartCompat="@drawable/bg_status_dot"
                app:drawableTint="@color/slot_occupied" />

            <TextView
                style="@style/Widget.ParkEase.Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:drawablePadding="@dimen/space_xs"
                android:gravity="center_vertical"
                android:text="@string/status_maintenance"
                app:drawableStartCompat="@drawable/bg_status_dot"
                app:drawableTint="@color/slot_maintenance" />
        </LinearLayout>

        <!-- ================= Floors ================= -->
        <HorizontalScrollView
            android:id="@+id/floorScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_padding"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipFloors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <!-- ================= Slot grid ================= -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSlots"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/space_md"
                    android:paddingBottom="@dimen/space_lg"
                    tools:itemCount="12"
                    tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    tools:listitem="@layout/item_slot_grid"
                    tools:spanCount="4" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <com.parkease.app.ui.components.StateView
                android:id="@+id/stateView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg_screen" />
        </FrameLayout>

        <!-- ================= Selected slot panel ================= -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ParkEase.Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:id="@+id/bottomPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding"
                android:paddingVertical="@dimen/space_md">

                <TextView
                    android:id="@+id/tvHint"
                    style="@style/Widget.ParkEase.Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="@dimen/space_sm"
                    android:text="@string/slots_tap_hint" />

                <LinearLayout
                    android:id="@+id/selectedGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSelectedTitle"
                            style="@style/Widget.ParkEase.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.ParkEase.TitleLarge"
                            tools:text="Slot A-07" />

                        <TextView
                            android:id="@+id/tvSelectedPlace"
                            style="@style/Widget.ParkEase.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="Ground floor · Zone A" />

                        <TextView
                            android:id="@+id/tvSelectedInfo"
                            style="@style/Widget.ParkEase.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="Car · ₹50 per hour · 2 h" />

                        <TextView
                            android:id="@+id/tvSelectedId"
                            style="@style/Widget.ParkEase.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_hint"
                            tools:text="Slot ID: SGH01-G-A-007" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.ParkEase.TitleLarge"
                            android:textColor="@color/brand_secondary"
                            tools:text="₹100" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReserve"
                            style="@style/Widget.ParkEase.Button.Primary.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/slots_reserve" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.parkease.app.ui.components.LoadingView
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:lvMessage="@string/slots_reserving"
        app:lvOverlay="true" />

    <include
        android:id="@+id/statusBarScrim"
        layout="@layout/view_status_bar_scrim" />
</FrameLayout>
