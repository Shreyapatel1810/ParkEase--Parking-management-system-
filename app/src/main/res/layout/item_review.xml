<?xml version="1.0" encoding="utf-8"?>
<!-- One customer review. Used by ReviewAdapter on the location details screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/space_md">

    <TextView
        android:id="@+id/tvInitials"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_circle"
        android:backgroundTint="@color/accent_navy_bg"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.ParkEase.Label"
        android:textColor="@color/accent_navy"
        tools:text="PM" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvName"
                style="@style/Widget.ParkEase.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_medium"
                android:maxLines="1"
                tools:text="Priya Mehta" />

            <TextView
                android:id="@+id/tvDate"
                style="@style/Widget.ParkEase.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="3 days ago" />
        </LinearLayout>

        <RatingBar
            android:id="@+id/ratingBar"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xs"
            android:isIndicator="true"
            android:numStars="5"
            android:progressBackgroundTint="@color/stroke"
            android:progressTint="@color/slot_reserved"
            android:secondaryProgressTint="@color/slot_reserved"
            android:stepSize="1"
            tools:rating="4" />

        <TextView
            android:id="@+id/tvComment"
            style="@style/Widget.ParkEase.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            tools:text="Clean, well lit and right next to the riverfront walk." />
    </LinearLayout>
</LinearLayout>
