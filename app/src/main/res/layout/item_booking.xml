<?xml version="1.0" encoding="utf-8"?>
<!-- One booking in "My Bookings" and the Home "Upcoming booking" card. Used by BookingAdapter / HomeFragment. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/icon_container"
                android:layout_height="@dimen/icon_container"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/accent_navy_bg">

                <ImageView
                    android:id="@+id/imgVehicle"
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_car"
                    app:tint="@color/accent_navy" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLocation"
                    style="@style/Widget.ParkEase.Text.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="SG Highway Central Parking" />

                <TextView
                    android:id="@+id/tvSlot"
                    style="@style/Widget.ParkEase.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Slot A-07 · GJ01AB1234" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatus"
                style="@style/Widget.ParkEase.Text.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Confirmed" />
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            style="@style/Widget.ParkEase.Divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/space_md" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTime"
                style="@style/Widget.ParkEase.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="@dimen/space_sm"
                android:gravity="center_vertical"
                app:drawableStartCompat="@drawable/ic_clock"
                app:drawableTint="@color/text_secondary"
                tools:text="Today · 4:30 PM – 6:30 PM" />

            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.ParkEase.Title"
                android:textColor="@color/text_primary"
                tools:text="₹100" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCode"
            style="@style/Widget.ParkEase.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            tools:text="PE-DEMO01" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
