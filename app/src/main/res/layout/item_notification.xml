<?xml version="1.0" encoding="utf-8"?>
<!-- One notification row. Used by NotificationAdapter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/card_padding"
    android:paddingVertical="@dimen/space_md">

    <FrameLayout
        android:layout_width="@dimen/icon_container"
        android:layout_height="@dimen/icon_container"
        android:background="@drawable/bg_icon_circle"
        android:backgroundTint="@color/brand_secondary_container">

        <ImageView
            android:id="@+id/imgIcon"
            android:layout_width="@dimen/icon_sm"
            android:layout_height="@dimen/icon_sm"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_notifications"
            app:tint="@color/brand_secondary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Widget.ParkEase.Text.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Booking confirmed" />

        <TextView
            android:id="@+id/tvMessage"
            style="@style/Widget.ParkEase.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Slot A-07 at SG Highway Central Parking is reserved for you." />

        <TextView
            android:id="@+id/tvTime"
            style="@style/Widget.ParkEase.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            tools:text="5 minutes ago" />
    </LinearLayout>

    <View
        android:id="@+id/unreadDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginTop="@dimen/space_xs"
        android:background="@drawable/bg_status_dot"
        android:backgroundTint="@color/brand_secondary" />
</LinearLayout>
