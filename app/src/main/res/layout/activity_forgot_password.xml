<?xml version="1.0" encoding="utf-8"?>
<!--
    Forgot password screen. Java: ui/auth/ForgotPasswordActivity.java
    Two states inside the card: the email form, and a "check your email" success message.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    tools:context=".ui.auth.ForgotPasswordActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_xl">

            <include
                android:id="@+id/header"
                layout="@layout/layout_header_toolbar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.ParkEase.Card.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/header_overlap">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- State 1: email form -->
                        <LinearLayout
                            android:id="@+id/formGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/card_padding">

                            <TextView
                                android:id="@+id/tvFirebaseWarning"
                                style="@style/Widget.ParkEase.Text.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/space_lg"
                                android:background="@drawable/bg_input_field"
                                android:backgroundTint="@color/error_container"
                                android:drawablePadding="@dimen/space_sm"
                                android:padding="@dimen/space_md"
                                android:text="@string/err_firebase_not_configured"
                                android:textColor="@color/error"
                                android:visibility="gone"
                                app:drawableStartCompat="@drawable/ic_error"
                                app:drawableTint="@color/error" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilEmail"
                                style="@style/Widget.ParkEase.TextInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/field_email"
                                app:startIconDrawable="@drawable/ic_email">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etEmail"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:autofillHints="emailAddress"
                                    android:imeOptions="actionSend"
                                    android:inputType="textEmailAddress"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSend"
                                style="@style/Widget.ParkEase.Button.Primary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xl"
                                android:text="@string/forgot_button"
                                app:icon="@drawable/ic_email" />
                        </LinearLayout>

                        <!-- State 2: success message -->
                        <com.parkease.app.ui.components.EmptyStateView
                            android:id="@+id/successState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:esActionText="@string/forgot_back_to_login"
                            app:esIcon="@drawable/ic_email"
                            app:esTitle="@string/forgot_sent_title" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.parkease.app.ui.components.LoadingView
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:lvMessage="@string/loading_reset"
        app:lvOverlay="true" />

    <include
        android:id="@+id/statusBarScrim"
        layout="@layout/view_status_bar_scrim" />

</FrameLayout>
