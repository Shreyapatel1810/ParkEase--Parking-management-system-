<?xml version="1.0" encoding="utf-8"?>
<!--
    Step 12 – Payment success / failure screen (SIMULATED).
    Java: ui/customer/payment/PaymentResultActivity.java
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    tools:context=".ui.customer.payment.PaymentResultActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <FrameLayout
                android:id="@+id/iconCircle"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="@dimen/space_2xl"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/slot_available_bg">

                <ImageView
                    android:id="@+id/imgResult"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/slot_available" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.ParkEase.Headline"
                android:textColor="@color/text_primary"
                tools:text="Payment successful" />

            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold"
                tools:text="₹100" />

            <TextView
                android:id="@+id/tvMessage"
                style="@style/Widget.ParkEase.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                tools:text="Your booking is confirmed." />

            <TextView
                style="@style/Widget.ParkEase.Text.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:backgroundTint="@color/slot_reserved_bg"
                android:text="@string/pay_simulated_tag"
                android:textColor="@color/slot_reserved" />

            <!-- Receipt -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <include
                        android:id="@+id/rowTxn"
                        layout="@layout/item_profile_row" />

                    <include
                        android:id="@+id/rowStatus"
                        layout="@layout/item_profile_row" />

                    <include
                        android:id="@+id/rowMethod"
                        layout="@layout/item_profile_row" />

                    <include
                        android:id="@+id/rowBooking"
                        layout="@layout/item_profile_row" />

                    <include
                        android:id="@+id/rowDate"
                        layout="@layout/item_profile_row" />

                    <include
                        android:id="@+id/rowReason"
                        layout="@layout/item_profile_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="@dimen/space_xl" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrimary"
                style="@style/Widget.ParkEase.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                tools:text="View booking" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSecondary"
                style="@style/Widget.ParkEase.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Done" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.parkease.app.ui.components.StateView
        android:id="@+id/stateView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_screen" />
</FrameLayout>
