<?xml version="1.0" encoding="utf-8"?>
<!--
    Booking summary / details (Step 11). Java: ui/customer/booking/BookingSummaryActivity.java
    Shown right after reserving a slot (confirm or release) and when a booking is opened
    from My Bookings (view, cancel).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    tools:context=".ui.customer.booking.BookingSummaryActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_xl">

                <include
                    android:id="@+id/header"
                    layout="@layout/layout_header_toolbar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/screen_padding">

                    <!-- ===== Where & when ===== -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.ParkEase.Card.Elevated"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/header_overlap">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/card_padding">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvLocation"
                                    style="@style/Widget.ParkEase.Text.CardTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textAppearance="@style/TextAppearance.ParkEase.TitleLarge"
                                    tools:text="SG Highway Central Parking" />

                                <TextView
                                    android:id="@+id/tvStatus"
                                    style="@style/Widget.ParkEase.Text.Badge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_sm"
                                    tools:text="Payment pending" />
                            </LinearLayout>

                            <!-- Hold countdown (pending only) -->
                            <TextView
                                android:id="@+id/tvHoldTimer"
                                style="@style/Widget.ParkEase.Text.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_md"
                                android:background="@drawable/bg_input_field"
                                android:backgroundTint="@color/slot_reserved_bg"
                                android:drawablePadding="@dimen/space_sm"
                                android:padding="@dimen/space_md"
                                android:textColor="@color/text_primary"
                                android:visibility="gone"
                                app:drawableStartCompat="@drawable/ic_clock"
                                app:drawableTint="@color/slot_reserved"
                                tools:text="Slot held for 9:42 – confirm before the timer ends"
                                tools:visibility="visible" />

                            <include
                                android:id="@+id/rowSlot"
                                layout="@layout/item_profile_row" />

                            <include
                                android:id="@+id/rowVehicle"
                                layout="@layout/item_profile_row" />

                            <include
                                android:id="@+id/rowDate"
                                layout="@layout/item_profile_row" />

                            <include
                                android:id="@+id/rowTime"
                                layout="@layout/item_profile_row" />

                            <include
                                android:id="@+id/rowDuration"
                                layout="@layout/item_profile_row" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ===== Price ===== -->
                    <TextView
                        style="@style/Widget.ParkEase.Text.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/section_spacing"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:text="@string/summary_price" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/card_padding">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvRateLine"
                                    style="@style/Widget.ParkEase.Text.Secondary"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    tools:text="₹50 × 2 h" />

                                <TextView
                                    android:id="@+id/tvRateAmount"
                                    style="@style/Widget.ParkEase.Text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="₹100" />
                            </LinearLayout>

                            <com.google.android.material.divider.MaterialDivider
                                style="@style/Widget.ParkEase.Divider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginVertical="@dimen/space_md" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/Widget.ParkEase.Text.CardTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/summary_total" />

                                <TextView
                                    android:id="@+id/tvTotal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.ParkEase.Headline"
                                    android:textColor="@color/brand_secondary"
                                    tools:text="₹100" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/refundGroup"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm"
                                android:orientation="horizontal"
                                android:visibility="gone"
                                tools:visibility="visible">

                                <TextView
                                    style="@style/Widget.ParkEase.Text.Secondary"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/summary_refund" />

                                <TextView
                                    android:id="@+id/tvRefund"
                                    style="@style/Widget.ParkEase.Text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/success"
                                    tools:text="₹100" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ===== IDs ===== -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.ParkEase.Card.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="@dimen/card_padding">

                            <TextView
                                android:id="@+id/tvCode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textColor="@color/text_primary"
                                android:textIsSelectable="true"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                tools:text="PE-7K3D9Q" />

                            <TextView
                                android:id="@+id/tvBookingId"
                                style="@style/Widget.ParkEase.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:textIsSelectable="true"
                                tools:text="Booking ID: -Nx81kQ2abcdEFgh" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvPolicy"
                        style="@style/Widget.ParkEase.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:drawablePadding="@dimen/space_sm"
                        app:drawableStartCompat="@drawable/ic_shield"
                        app:drawableTint="@color/text_secondary"
                        tools:text="Free cancellation up to 60 minutes before the start." />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===== Actions ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ParkEase.Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:id="@+id/actionBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding"
                android:paddingVertical="@dimen/space_md">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrimary"
                    style="@style/Widget.ParkEase.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Confirm booking" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSecondary"
                    style="@style/Widget.ParkEase.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Release slot" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.parkease.app.ui.components.StateView
        android:id="@+id/stateView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_screen" />

    <com.parkease.app.ui.components.LoadingView
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:lvMessage="@string/summary_confirming"
        app:lvOverlay="true" />

    <include
        android:id="@+id/statusBarScrim"
        layout="@layout/view_status_bar_scrim" />
</FrameLayout>
