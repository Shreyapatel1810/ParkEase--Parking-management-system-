<?xml version="1.0" encoding="utf-8"?>
<!--
    Step 14 – A booking that is happening now (Active tab): big slot number, live progress
    of the booked time and the QR ticket button. Used by adapters/ActiveBookingAdapter.java
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    style="@style/Widget.ParkEase.Card.Elevated"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Navy top band -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_flat"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.ParkEase.TitleLarge"
                    android:textColor="@android:color/white"
                    tools:text="SG Highway Central Parking" />

                <TextView
                    android:id="@+id/tvCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:fontFamily="monospace"
                    android:textColor="@android:color/white"
                    tools:text="PE-7K3D9Q" />
            </LinearLayout>

            <!-- Big slot number -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:background="@drawable/bg_rounded_tintable"
                android:backgroundTint="@color/brand_secondary"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_sm">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mb_slot"
                    android:textColor="@android:color/white"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvSlot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="A-07" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <!-- Status line + badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvState"
                    style="@style/Widget.ParkEase.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Parked since 10:05 AM" />

                <TextView
                    android:id="@+id/tvStatus"
                    style="@style/Widget.ParkEase.Text.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    tools:text="Parked" />
            </LinearLayout>

            <!-- Time progress -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:max="1000"
                app:indicatorColor="@color/brand_secondary"
                app:trackColor="@color/bg_subtle"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp"
                tools:progress="450" />

            <TextView
                android:id="@+id/tvRemaining"
                style="@style/Widget.ParkEase.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                tools:text="1 h 05 min left · ends 12:00 PM" />

            <!-- Vehicle · time · payment -->
            <TextView
                android:id="@+id/tvVehicleTime"
                style="@style/Widget.ParkEase.Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:drawablePadding="@dimen/space_sm"
                app:drawableStartCompat="@drawable/ic_car"
                app:drawableTint="@color/text_secondary"
                tools:text="GJ 01 AB 1234 · Today, 10:00 AM – 12:00 PM" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPaymentMethod"
                    style="@style/Widget.ParkEase.Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="@dimen/space_sm"
                    app:drawableStartCompat="@drawable/ic_rupee"
                    app:drawableTint="@color/text_secondary"
                    tools:text="Cash at parking · ₹100" />

                <TextView
                    android:id="@+id/tvPaymentStatus"
                    style="@style/Widget.ParkEase.Text.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Pending" />
            </LinearLayout>

            <!-- Actions -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTicket"
                style="@style/Widget.ParkEase.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/mb_show_ticket"
                app:icon="@drawable/ic_qr_scan" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetails"
                    style="@style/Widget.ParkEase.Button.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mb_action_details" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReceipt"
                    style="@style/Widget.ParkEase.Button.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mb_action_receipt" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
