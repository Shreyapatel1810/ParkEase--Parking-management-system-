<?xml version="1.0" encoding="utf-8"?>
<!-- Inside of SearchBarView (ui/components/SearchBarView.java): icon, text field, clear and filter buttons -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="com.google.android.material.card.MaterialCardView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_xs">

        <ImageView
            android:layout_width="@dimen/icon_sm"
            android:layout_height="@dimen/icon_sm"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            app:tint="@color/text_secondary" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:background="@null"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.ParkEase.BodyLarge"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            tools:hint="Search area, mall or city" />

        <ImageButton
            android:id="@+id/btnClear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_clear"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/text_secondary" />

        <View
            android:id="@+id/filterDivider"
            android:layout_width="@dimen/stroke_thin"
            android:layout_height="24dp"
            android:layout_marginHorizontal="@dimen/space_xs"
            android:background="@color/stroke" />

        <ImageButton
            android:id="@+id/btnFilter"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_filter"
            android:src="@drawable/ic_filter"
            app:tint="@color/brand_secondary" />
    </LinearLayout>

</merge>
