<?xml version="1.0" encoding="utf-8"?>
<!-- Add / edit a vehicle. Java: ui/customer/vehicle/AddEditVehicleActivity.java -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    tools:context=".ui.customer.vehicle.AddEditVehicleActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_xl">

            <include
                android:id="@+id/header"
                layout="@layout/layout_header_toolbar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.ParkEase.Card.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/header_overlap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <!-- Live number-plate preview -->
                        <TextView
                            android:id="@+id/tvPlatePreview"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginBottom="@dimen/space_lg"
                            android:background="@drawable/bg_number_plate"
                            android:fontFamily="monospace"
                            android:minWidth="200dp"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/space_lg"
                            android:paddingVertical="@dimen/space_sm"
                            android:textColor="@color/grey_900"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="GJ 01 AB 1234" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilRegistration"
                            style="@style/Widget.ParkEase.TextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/field_registration"
                            app:helperText="@string/field_registration_helper"
                            app:startIconDrawable="@drawable/ic_car">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etRegistration"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="textCapCharacters|textNoSuggestions"
                                android:maxLength="13"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            style="@style/Widget.ParkEase.Text.Overline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_lg"
                            android:text="@string/field_vehicle_type" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/toggleType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            app:checkedButton="@+id/btnTypeCar"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTypeCar"
                                style="@style/Widget.ParkEase.Button.Secondary.Small"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/vehicle_car"
                                app:icon="@drawable/ic_car" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTypeSuv"
                                style="@style/Widget.ParkEase.Button.Secondary.Small"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/vehicle_suv"
                                app:icon="@drawable/ic_car" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTypeBike"
                                style="@style/Widget.ParkEase.Button.Secondary.Small"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/vehicle_bike"
                                app:icon="@drawable/ic_bike" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <TextView
                            android:id="@+id/tvTypeHint"
                            style="@style/Widget.ParkEase.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/vehicle_type_hint_suv"
                            android:visibility="gone" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilNickname"
                            style="@style/Widget.ParkEase.TextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_lg"
                            android:hint="@string/field_nickname"
                            app:counterEnabled="true"
                            app:counterMaxLength="30"
                            app:helperText="@string/field_nickname_helper"
                            app:startIconDrawable="@drawable/ic_edit">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etNickname"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="textCapSentences"
                                android:maxLength="30"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSave"
                            style="@style/Widget.ParkEase.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xl"
                            android:text="@string/vehicle_save" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDelete"
                            style="@style/Widget.ParkEase.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/space_sm"
                            android:text="@string/vehicle_delete"
                            android:textColor="@color/error"
                            android:visibility="gone"
                            app:icon="@drawable/ic_close"
                            app:iconTint="@color/error"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.parkease.app.ui.components.LoadingView
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:lvMessage="@string/vehicle_saving"
        app:lvOverlay="true" />

    <include
        android:id="@+id/statusBarScrim"
        layout="@layout/view_status_bar_scrim" />
</FrameLayout>
