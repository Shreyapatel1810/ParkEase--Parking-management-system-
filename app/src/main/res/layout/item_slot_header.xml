<?xml version="1.0" encoding="utf-8"?>
<!-- Zone heading that spans the whole grid row, e.g. "Zone A · 18 free". -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tvHeader"
    style="@style/Widget.ParkEase.Text.Overline"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/space_xs"
    android:paddingTop="@dimen/space_lg"
    android:paddingBottom="@dimen/space_xs"
    tools:text="Zone A · 18 free" />
