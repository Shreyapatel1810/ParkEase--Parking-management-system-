<?xml version="1.0" encoding="utf-8"?>
<!-- Sort & filter bottom sheet for Explore. Java: ui/customer/search/SortFilterBottomSheet.java -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_xl">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/Widget.ParkEase.Text.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_filter_title" />

        <!-- Sort -->
        <TextView
            style="@style/Widget.ParkEase.Text.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/sort_by" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/groupSort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/sortRecommended"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sort_recommended" />

            <com.google.android.material.chip.Chip
                android:id="@+id/sortPriceLow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sort_price_low" />

            <com.google.android.material.chip.Chip
                android:id="@+id/sortPriceHigh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sort_price_high" />

            <com.google.android.material.chip.Chip
                android:id="@+id/sortAvailable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sort_most_available" />

            <com.google.android.material.chip.Chip
                android:id="@+id/sortRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sort_top_rated" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Vehicle type -->
        <TextView
            style="@style/Widget.ParkEase.Text.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/filter_vehicle" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/groupVehicle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/vehicleAny"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_vehicle_any" />

            <com.google.android.material.chip.Chip
                android:id="@+id/vehicleCar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/explore_filter_car"
                app:chipIcon="@drawable/ic_car"
                app:chipIconVisible="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/vehicleBike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/explore_filter_bike"
                app:chipIcon="@drawable/ic_bike"
                app:chipIconVisible="true" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Max price -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.ParkEase.Text.Overline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/filter_max_price" />

            <TextView
                android:id="@+id/tvPriceValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.ParkEase.Label"
                android:textColor="@color/brand_secondary" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="10"
            android:valueFrom="10"
            android:valueTo="100"
            app:labelBehavior="gone"
            app:thumbColor="@color/brand_secondary"
            app:trackColorActive="@color/brand_secondary"
            app:trackColorInactive="@color/brand_secondary_container" />

        <!-- Availability & facilities -->
        <TextView
            style="@style/Widget.ParkEase.Text.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/filter_availability" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAvailable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/explore_filter_available" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/explore_filter_ev"
                app:chipIcon="@drawable/ic_bolt"
                app:chipIconVisible="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCovered"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/explore_filter_covered" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                style="@style/Widget.ParkEase.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:text="@string/filter_reset" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApply"
                style="@style/Widget.ParkEase.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="@string/filter_apply" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
