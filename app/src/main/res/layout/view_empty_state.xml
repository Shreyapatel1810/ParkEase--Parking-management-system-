<?xml version="1.0" encoding="utf-8"?>
<!-- Inside of EmptyStateView (ui/components/EmptyStateView.java) -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:gravity="center"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <FrameLayout
        android:layout_width="@dimen/empty_icon_container"
        android:layout_height="@dimen/empty_icon_container"
        android:background="@drawable/bg_icon_circle"
        android:backgroundTint="@color/brand_secondary_container">

        <ImageView
            android:id="@+id/imgEmptyIcon"
            android:layout_width="@dimen/empty_icon"
            android:layout_height="@dimen/empty_icon"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/brand_secondary"
            tools:src="@drawable/ic_bookings" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvEmptyTitle"
        style="@style/Widget.ParkEase.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.ParkEase.TitleLarge"
        tools:text="No bookings yet" />

    <TextView
        android:id="@+id/tvEmptyMessage"
        style="@style/Widget.ParkEase.Text.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center"
        android:maxWidth="320dp"
        tools:text="When you book a parking slot, it will show up here." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmptyAction"
        style="@style/Widget.ParkEase.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:paddingHorizontal="@dimen/space_2xl"
        android:visibility="gone"
        tools:text="Find parking"
        tools:visibility="visible" />

</merge>
