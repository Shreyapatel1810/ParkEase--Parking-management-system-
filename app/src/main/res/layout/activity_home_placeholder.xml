<?xml version="1.0" encoding="utf-8"?>
<!--
    Temporary dashboard used by BOTH CustomerMainActivity and AdminMainActivity
    until the real dashboards are built. Shows the logged-in profile and a Log out button.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_xl">

            <include
                android:id="@+id/header"
                layout="@layout/layout_header_toolbar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding">

                <!-- Profile card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.ParkEase.Card.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/header_overlap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/card_padding">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp">

                            <TextView
                                android:id="@+id/tvAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_icon_circle"
                                android:backgroundTint="@color/brand_secondary_container"
                                android:gravity="center"
                                android:textAppearance="@style/TextAppearance.ParkEase.TitleLarge"
                                android:textColor="@color/brand_on_secondary_container"
                                tools:text="RS" />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/imgAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/cd_profile_photo"
                                android:scaleType="centerCrop"
                                android:visibility="gone"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.ParkEase.Circle" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_lg"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvName"
                                style="@style/Widget.ParkEase.Text.CardTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                tools:text="Rahul Shah" />

                            <TextView
                                android:id="@+id/tvEmail"
                                style="@style/Widget.ParkEase.Text.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                tools:text="rahul@example.com" />

                            <TextView
                                android:id="@+id/tvPhone"
                                style="@style/Widget.ParkEase.Text.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                tools:text="+91 98765 43210" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvRole"
                            style="@style/Widget.ParkEase.Text.Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Customer" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- What comes next -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <com.parkease.app.ui.components.EmptyStateView
                        android:id="@+id/comingSoon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:esIcon="@drawable/ic_dashboard"
                        app:esTitle="@string/home_coming_title" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Admin only: writes demo data to Firebase (see SampleDataSeeder) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeed"
                    style="@style/Widget.ParkEase.Button.Accent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:text="@string/admin_seed_button"
                    android:visibility="gone"
                    app:icon="@drawable/ic_add"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProfile"
                    style="@style/Widget.ParkEase.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:text="@string/profile_view"
                    app:icon="@drawable/ic_profile" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    style="@style/Widget.ParkEase.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/action_logout"
                    app:icon="@drawable/ic_logout" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/statusBarScrim"
        layout="@layout/view_status_bar_scrim" />

</FrameLayout>
