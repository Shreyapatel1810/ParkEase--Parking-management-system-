<?xml version="1.0" encoding="utf-8"?>
<!--
    ParkEase dimensions – phones (default).
    Tablets / large screens use values-sw600dp/dimens.xml, which overrides some values.
    Rule: never type "16dp" in a layout – use @dimen/... so every screen stays consistent.
-->
<resources>
    <!-- ===== Spacing scale (4dp grid) ===== -->
    <dimen name="space_2xs">2dp</dimen>
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">12dp</dimen>
    <dimen name="space_lg">16dp</dimen>
    <dimen name="space_xl">24dp</dimen>
    <dimen name="space_2xl">32dp</dimen>
    <dimen name="space_3xl">48dp</dimen>

    <!-- ===== Layout ===== -->
    <dimen name="screen_padding">16dp</dimen>         <!-- left/right margin of every screen -->
    <dimen name="section_spacing">24dp</dimen>        <!-- gap between sections -->
    <dimen name="card_padding">16dp</dimen>
    <dimen name="card_gap">12dp</dimen>               <!-- gap between cards in a grid -->
    <dimen name="header_padding_bottom">48dp</dimen>  <!-- room for a card overlapping the header -->
    <dimen name="header_overlap">-32dp</dimen>

    <!-- ===== Corner radius ===== -->
    <dimen name="radius_sm">8dp</dimen>
    <dimen name="radius_md">12dp</dimen>
    <dimen name="radius_lg">16dp</dimen>
    <dimen name="radius_xl">24dp</dimen>
    <dimen name="radius_pill">100dp</dimen>
    <dimen name="radius_card">16dp</dimen>
    <dimen name="radius_button">14dp</dimen>
    <dimen name="radius_input">14dp</dimen>
    <dimen name="radius_slot">12dp</dimen>
    <dimen name="radius_header">28dp</dimen>

    <!-- ===== Component sizes ===== -->
    <dimen name="button_height">54dp</dimen>
    <dimen name="button_height_small">40dp</dimen>
    <dimen name="input_height">56dp</dimen>
    <dimen name="search_bar_height">52dp</dimen>
    <dimen name="toolbar_height">56dp</dimen>
    <dimen name="slot_width">72dp</dimen>
    <dimen name="slot_height">88dp</dimen>
    <dimen name="stroke_thin">1dp</dimen>
    <dimen name="stroke_slot">1.5dp</dimen>
    <dimen name="stroke_selected">2.5dp</dimen>
    <dimen name="card_elevation">0dp</dimen>
    <dimen name="card_elevation_raised">4dp</dimen>
    <dimen name="swatch_size">48dp</dimen>

    <!-- ===== Icon sizes ===== -->
    <dimen name="icon_xs">16dp</dimen>
    <dimen name="icon_sm">20dp</dimen>
    <dimen name="icon_md">24dp</dimen>
    <dimen name="icon_lg">32dp</dimen>
    <dimen name="icon_container">44dp</dimen>
    <dimen name="empty_icon_container">104dp</dimen>
    <dimen name="empty_icon">52dp</dimen>
    <dimen name="logo_size">64dp</dimen>
    <dimen name="progress_size">48dp</dimen>

    <!-- ===== Text sizes (Material 3 type scale) ===== -->
    <dimen name="text_display">32sp</dimen>
    <dimen name="text_headline">24sp</dimen>
    <dimen name="text_title_large">20sp</dimen>
    <dimen name="text_title">16sp</dimen>
    <dimen name="text_body_large">16sp</dimen>
    <dimen name="text_body">14sp</dimen>
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_overline">11sp</dimen>
    <dimen name="text_stat">26sp</dimen>
</resources>
