<?xml version="1.0" encoding="utf-8"?>
<!--
    ParkEase styles – the reusable look of every widget.
    How to use:   style="@style/Widget.ParkEase.Button.Primary"
    Many styles are also set as theme defaults (see themes.xml), so a plain
    MaterialButton / MaterialCardView / TextInputLayout already looks right.
-->
<resources>

    <!-- ======================================================================
         TYPOGRAPHY (TextAppearance = font + size only; colour comes from the view)
         ====================================================================== -->
    <style name="TextAppearance.ParkEase.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.ParkEase.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">@dimen/text_headline</item>
    </style>

    <style name="TextAppearance.ParkEase.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">@dimen/text_title_large</item>
    </style>

    <style name="TextAppearance.ParkEase.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">@dimen/text_title</item>
    </style>

    <style name="TextAppearance.ParkEase.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">@dimen/text_body_large</item>
    </style>

    <style name="TextAppearance.ParkEase.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="TextAppearance.ParkEase.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <style name="TextAppearance.ParkEase.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.ParkEase.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">@dimen/text_overline</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.ParkEase.Stat" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">@dimen/text_stat</item>
    </style>

    <!-- ======================================================================
         TEXT VIEW STYLES (font + colour) – use these for repeated labels
         ====================================================================== -->
    <style name="Widget.ParkEase.Text" parent="">
        <item name="android:textAppearance">@style/TextAppearance.ParkEase.Body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.ParkEase.Text.ScreenTitle">
        <item name="android:textAppearance">@style/TextAppearance.ParkEase.Headline</item>
    </style>

    <style name="Widget.ParkEase.Text.SectionTitle">
        <item name="android:textAppearance">@style/TextAppearance.ParkEase.TitleLarge</item>
        <item name="android:layout_marginBottom">@dimen/space_md</item>
    </style>

    <style name="Widget.ParkEase.Text.CardTitle">
        <item name="android:textAppearance">@style/TextAppearance.ParkEase.Title</item>
    </style>

    <style name="Widget.ParkEase.Text.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.ParkEase.Text.Caption">
        <item name="android:textAppearance">@style/TextAppearance.ParkEase.Caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.ParkEase.Text.Overline">
        <item name="android:textAppearance">@style/TextAppearance.ParkEase.Overline</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.ParkEase.Text.Link">
        <item name="android:textAppearance">@style/TextAppearance.ParkEase.Label</item>
        <item name="android:textColor">@color/text_link</item>
    </style>

    <style name="Widget.ParkEase.Text.OnHeader">
        <item name="android:textColor">@color/text_on_header</item>
    </style>

    <style name="Widget.ParkEase.Text.OnHeader.Secondary">
        <item name="android:textColor">@color/text_on_header_secondary</item>
    </style>

    <!-- Small coloured status pill, e.g. "AVAILABLE" -->
    <style name="Widget.ParkEase.Text.Badge">
        <item name="android:textAppearance">@style/TextAppearance.ParkEase.Overline</item>
        <item name="android:textColor">@color/brand_on_secondary_container</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/space_xs</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
    </style>

    <!-- ======================================================================
         BUTTONS
         ====================================================================== -->
    <!-- Primary: main action of a screen (Login, Book Now, Pay) -->
    <style name="Widget.ParkEase.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="backgroundTint">@color/selector_button_primary_bg</item>
        <item name="android:textColor">@color/selector_button_primary_text</item>
        <item name="iconTint">@color/selector_button_primary_text</item>
        <item name="android:textAppearance">@style/TextAppearance.ParkEase.Label</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/space_sm</item>
    </style>

    <!-- Accent: teal highlight action (View Ticket, Scan QR) -->
    <style name="Widget.ParkEase.Button.Accent" parent="Widget.ParkEase.Button.Primary">
        <item name="backgroundTint">@color/selector_button_accent_bg</item>
        <item name="android:textColor">@color/selector_button_accent_text</item>
        <item name="iconTint">@color/selector_button_accent_text</item>
    </style>

    <!-- Danger: destructive action (Cancel Booking, Delete) -->
    <style name="Widget.ParkEase.Button.Danger" parent="Widget.ParkEase.Button.Primary">
        <item name="backgroundTint">@color/selector_button_danger_bg</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
    </style>

    <!-- Secondary: outlined, second choice next to a primary button -->
    <style name="Widget.ParkEase.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="strokeColor">@color/selector_button_outline</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
        <item name="android:textColor">@color/selector_button_outline</item>
        <item name="iconTint">@color/selector_button_outline</item>
        <item name="android:textAppearance">@style/TextAppearance.ParkEase.Label</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/space_sm</item>
    </style>

    <!-- Text button: low-emphasis links (Forgot password?, View all) -->
    <style name="Widget.ParkEase.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/text_link</item>
        <item name="iconTint">@color/text_link</item>
        <item name="android:textAppearance">@style/TextAppearance.ParkEase.Label</item>
    </style>

    <!-- Smaller versions for cards and lists -->
    <style name="Widget.ParkEase.Button.Primary.Small">
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="cornerRadius">@dimen/radius_md</item>
    </style>

    <style name="Widget.ParkEase.Button.Secondary.Small">
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="cornerRadius">@dimen/radius_md</item>
    </style>

    <!-- Compact text button for card action rows (My Bookings) -->
    <style name="Widget.ParkEase.Button.Text.Small">
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="iconSize">18dp</item>
    </style>

    <!-- ======================================================================
         TEXT INPUT
         ====================================================================== -->
    <style name="Widget.ParkEase.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="boxBackgroundColor">@color/bg_card</item>
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="boxStrokeWidth">@dimen/stroke_thin</item>
        <item name="boxStrokeWidthFocused">@dimen/stroke_slot</item>
        <item name="boxStrokeErrorColor">@color/error</item>
        <item name="hintTextColor">@color/brand_secondary</item>
        <item name="android:textColorHint">@color/selector_input_hint</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="endIconTint">@color/text_secondary</item>
        <item name="errorTextColor">@color/error</item>
        <item name="errorIconTint">@color/error</item>
        <item name="hintTextAppearance">@style/TextAppearance.ParkEase.Caption</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.ParkEase.Caption</item>
        <item name="errorTextAppearance">@style/TextAppearance.ParkEase.Caption</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.ParkEase.TextInputEditText</item>
    </style>

    <!-- Makes the inner EditText use ParkEase text size and colour -->
    <style name="ThemeOverlay.ParkEase.TextInputEditText" parent="">
        <item name="editTextStyle">@style/Widget.ParkEase.TextInputEditText</item>
    </style>

    <style name="Widget.ParkEase.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textAppearance">@style/TextAppearance.ParkEase.BodyLarge</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Drop-down field (vehicle type, city) -->
    <style name="Widget.ParkEase.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="boxBackgroundColor">@color/bg_card</item>
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="hintTextColor">@color/brand_secondary</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="endIconTint">@color/text_secondary</item>
    </style>

    <!-- ======================================================================
         CARDS
         ====================================================================== -->
    <!-- Default card: flat, white, thin border (theme default for MaterialCardView) -->
    <style name="Widget.ParkEase.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
        <item name="rippleColor">@color/brand_secondary_container</item>
    </style>

    <!-- Raised card: floats above content (card overlapping the header) -->
    <style name="Widget.ParkEase.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardElevation">@dimen/card_elevation_raised</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Filled card: soft grey panel for secondary information -->
    <style name="Widget.ParkEase.Card.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardBackgroundColor">@color/bg_subtle</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- ======================================================================
         TOOLBARS
         ====================================================================== -->
    <!-- Default toolbar: on the screen background, dark text -->
    <style name="Widget.ParkEase.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/bg_screen</item>
        <item name="android:minHeight">@dimen/toolbar_height</item>
        <item name="titleTextAppearance">@style/TextAppearance.ParkEase.TitleLarge</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.ParkEase.Caption</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="navigationIconTint">@color/text_primary</item>
    </style>

    <!-- Navy toolbar: used inside the navy header -->
    <style name="Widget.ParkEase.Toolbar.Header">
        <item name="android:background">@color/transparent</item>
        <item name="titleTextColor">@color/text_on_header</item>
        <item name="subtitleTextColor">@color/text_on_header_secondary</item>
        <item name="navigationIconTint">@color/text_on_header</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.ParkEase.Toolbar.Header</item>
    </style>

    <!-- White overflow (⋮) and menu icons on the navy toolbar -->
    <style name="ThemeOverlay.ParkEase.Toolbar.Header" parent="">
        <item name="colorControlNormal">@color/text_on_header</item>
        <item name="colorOnSurface">@color/text_on_header</item>
        <item name="colorOnSurfaceVariant">@color/text_on_header</item>
    </style>

    <!-- ======================================================================
         BOTTOM NAVIGATION
         ====================================================================== -->
    <style name="Widget.ParkEase.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/bg_card</item>
        <item name="itemIconTint">@color/selector_bottom_nav</item>
        <item name="itemTextColor">@color/selector_bottom_nav</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.ParkEase.Caption</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.ParkEase.Caption</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.ParkEase.BottomNavigation.Indicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">@dimen/card_elevation_raised</item>
    </style>

    <style name="Widget.ParkEase.BottomNavigation.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/brand_secondary_container</item>
    </style>

    <!-- ======================================================================
         CHIPS, PROGRESS, SWITCH, DIVIDER
         ====================================================================== -->
    <!-- Filter chips (Car / Bike / Covered / EV) -->
    <style name="Widget.ParkEase.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/selector_chip_bg</item>
        <item name="chipStrokeColor">@color/selector_chip_stroke</item>
        <item name="chipStrokeWidth">@dimen/stroke_thin</item>
        <item name="android:textColor">@color/selector_chip_text</item>
        <item name="checkedIconTint">@color/selector_chip_text</item>
        <item name="chipIconTint">@color/selector_chip_text</item>
        <item name="chipCornerRadius">@dimen/radius_pill</item>
        <item name="android:textAppearance">@style/TextAppearance.ParkEase.Label</item>
    </style>

    <style name="Widget.ParkEase.Progress.Circular" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">@color/brand_secondary</item>
        <item name="trackColor">@color/brand_secondary_container</item>
        <item name="trackCornerRadius">@dimen/radius_pill</item>
        <item name="indicatorSize">@dimen/progress_size</item>
    </style>

    <style name="Widget.ParkEase.Progress.Linear" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">@color/brand_secondary</item>
        <item name="trackColor">@color/brand_secondary_container</item>
        <item name="trackCornerRadius">@dimen/radius_pill</item>
    </style>

    <style name="Widget.ParkEase.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:textAppearance">@style/TextAppearance.ParkEase.Body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Makes a ShapeableImageView round (profile photos) -->
    <style name="ShapeAppearance.ParkEase.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.ParkEase.Divider" parent="Widget.Material3.MaterialDivider">
        <item name="dividerColor">@color/stroke</item>
        <item name="dividerThickness">@dimen/stroke_thin</item>
    </style>

</resources>
