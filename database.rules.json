{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": ["email", "role"],

      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['uid', 'fullName', 'email', 'phone', 'role', 'blocked', 'createdAt'])",

        "uid": {
          ".validate": "newData.val() === $uid"
        },
        "fullName": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60"
        },
        "email": {
          ".validate": "newData.isString() && (newData.val() === auth.token.email.toLowerCase() || (data.exists() && newData.val() === data.val()))"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().matches(/^[6-9][0-9]{9}$/)"
        },
        "role": {
          ".validate": "(!data.exists() && newData.val() === 'customer') || (data.exists() && newData.val() === data.val())"
        },
        "blocked": {
          ".validate": "newData.isBoolean() && ((!data.exists() && newData.val() === false) || newData.val() === data.val() || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        },
        "createdAt": {
          ".validate": "(!data.exists() && newData.val() === now) || newData.val() === data.val()"
        },
        "updatedAt": {
          ".validate": "newData.val() === now"
        },
        "photo": {
          ".validate": "newData.isString() && newData.val().beginsWith('/9j/') && newData.val().length < 200000"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "locations": {
      ".read": "auth != null",
      ".indexOn": ["city", "active"],
      "$locationId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".validate": "newData.hasChildren(['name', 'address', 'city', 'carRatePerHour', 'totalSlots', 'availableSlots', 'active'])",
        "availableSlots": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('totalSlots').val()"
        }
      }
    },

    "bookings": {
      ".read": "auth != null && ((query.orderByChild === 'userId' && query.equalTo === auth.uid) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      ".indexOn": ["userId", "locationId", "status"],
      "$bookingId": {
        ".read": "auth != null && data.child('userId').val() === auth.uid",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "favourites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$locationId": {
          ".validate": "newData.isNumber() && root.child('locations').child($locationId).exists()"
        }
      }
    },

    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$notifId": {
          "isRead": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },

    "reviews": {
      ".read": "auth != null",
      "$locationId": {
        ".indexOn": ["createdAt"],
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$reviewerId": {
          ".write": "auth != null && auth.uid === $reviewerId",
          ".validate": "newData.hasChildren(['userName', 'rating', 'createdAt']) && newData.child('rating').isNumber() && newData.child('rating').val() >= 1 && newData.child('rating').val() <= 5 && (!newData.child('comment').exists() || (newData.child('comment').isString() && newData.child('comment').val().length <= 500))"
        }
      }
    },

    "promotions": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    }
  }
}
