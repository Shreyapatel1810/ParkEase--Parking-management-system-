{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": ["email", "role"],

      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['uid', 'fullName', 'email', 'phone', 'role', 'blocked', 'createdAt'])",

        "uid": {
          ".validate": "newData.val() === $uid"
        },
        "fullName": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60"
        },
        "email": {
          ".validate": "newData.isString() && (newData.val() === auth.token.email.toLowerCase() || (data.exists() && newData.val() === data.val()))"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().matches(/^[6-9][0-9]{9}$/)"
        },
        "role": {
          ".validate": "(!data.exists() && newData.val() === 'customer') || (data.exists() && newData.val() === data.val())"
        },
        "blocked": {
          ".validate": "newData.isBoolean() && ((!data.exists() && newData.val() === false) || newData.val() === data.val() || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        },
        "createdAt": {
          ".validate": "(!data.exists() && newData.val() === now) || newData.val() === data.val()"
        },
        "updatedAt": {
          ".validate": "newData.val() === now"
        },
        "photo": {
          ".validate": "newData.isString() && newData.val().beginsWith('/9j/') && newData.val().length < 200000"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "vehicles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && auth.uid === $uid",
        "$vehicleId": {
          ".validate": "newData.hasChildren(['userId', 'registrationNumber', 'vehicleType', 'createdAt']) && newData.child('userId').val() === $uid && newData.child('registrationNumber').val().matches(/^([A-Z]{2}[0-9]{1,2}[A-Z]{1,3}[0-9]{4}|[0-9]{2}BH[0-9]{4}[A-Z]{1,2})$/) && newData.child('vehicleType').val().matches(/^(CAR|BIKE|SUV)$/) && (!newData.child('nickname').exists() || (newData.child('nickname').isString() && newData.child('nickname').val().length <= 30)) && newData.parent().parent().parent().child('vehicleRegistrations').child($uid).child(newData.child('registrationNumber').val()).val() === $vehicleId"
        }
      }
    },

    "vehicleRegistrations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$regNo": {
          ".validate": "newData.isString() && newData.parent().parent().parent().child('vehicles').child($uid).child(newData.val()).child('registrationNumber').val() === $regNo && (!data.exists() || data.val() === newData.val() || newData.parent().parent().parent().child('vehicles').child($uid).child(data.val()).child('registrationNumber').val() !== $regNo)"
        }
      }
    },

    "locations": {
      ".read": "auth != null",
      ".indexOn": ["city", "active"],
      "$locationId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".validate": "newData.hasChildren(['name', 'address', 'city', 'carRatePerHour', 'totalSlots', 'availableSlots', 'active'])",
        "availableSlots": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('totalSlots').val()"
        }
      }
    },

    "slots": {
      ".read": "auth != null",
      "$locationId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$slotId": {
          ".validate": "newData.hasChildren(['slotNumber', 'vehicleType', 'status', 'pricePerHour']) && newData.child('status').val().matches(/^(AVAILABLE|RESERVED|OCCUPIED|MAINTENANCE)$/) && newData.child('vehicleType').val().matches(/^(CAR|BIKE)$/)"
        }
      }
    },

    "slotSchedule": {
      ".read": "auth != null",
      "$locationId": {
        "$date": {
          "$slotId": {
            "$time": {
              ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || !data.exists() || data.child('userId').val() === auth.uid || (data.child('status').val() === 'HOLD' && data.child('holdUntil').val() < now))",
              ".validate": "root.child('users').child(auth.uid).child('role').val() === 'admin' || (newData.hasChildren(['bookingId', 'userId', 'status', 'holdUntil']) && newData.child('userId').val() === auth.uid && newData.child('status').val() === 'HOLD' && newData.child('holdUntil').val() > now && newData.child('holdUntil').val() <= now + 900000 && $time.matches(/^([01][0-9]|2[0-3])(00|30)$/) && root.child('slots').child($locationId).child($slotId).exists() && root.child('slots').child($locationId).child($slotId).child('status').val() !== 'MAINTENANCE' && newData.parent().parent().parent().parent().parent().child('bookings').child(newData.child('bookingId').val()).child('userId').val() === auth.uid)"
            }
          }
        }
      }
    },

    "bookings": {
      ".read": "auth != null && ((query.orderByChild === 'userId' && query.equalTo === auth.uid) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      ".indexOn": ["userId", "locationId", "status"],
      "$bookingId": {
        ".read": "auth != null && data.child('userId').val() === auth.uid",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && newData.child('userId').val() === auth.uid && newData.child('status').val() === 'PENDING_PAYMENT') || (data.child('userId').val() === auth.uid && data.child('status').val() === 'PENDING_PAYMENT' && !newData.exists()))",
        ".validate": "!newData.exists() || root.child('users').child(auth.uid).child('role').val() === 'admin' || (newData.hasChildren(['bookingCode', 'userId', 'locationId', 'slotId', 'vehicleId', 'vehicleNumber', 'vehicleType', 'startTime', 'endTime', 'status', 'amount', 'holdUntil', 'createdAt']) && root.child('vehicles').child(auth.uid).child(newData.child('vehicleId').val()).child('registrationNumber').val() === newData.child('vehicleNumber').val() && newData.child('endTime').val() > newData.child('startTime').val() && newData.child('startTime').val() > now - 1800000 && newData.child('endTime').val() - newData.child('startTime').val() <= 43200000 && newData.child('amount').isNumber() && newData.child('holdUntil').val() <= now + 900000)"
      }
    },

    "favourites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$locationId": {
          ".validate": "newData.isNumber() && root.child('locations').child($locationId).exists()"
        }
      }
    },

    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$notifId": {
          "isRead": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },

    "reviews": {
      ".read": "auth != null",
      "$locationId": {
        ".indexOn": ["createdAt"],
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$reviewerId": {
          ".write": "auth != null && auth.uid === $reviewerId",
          ".validate": "newData.hasChildren(['userName', 'rating', 'createdAt']) && newData.child('rating').isNumber() && newData.child('rating').val() >= 1 && newData.child('rating').val() <= 5 && (!newData.child('comment').exists() || (newData.child('comment').isString() && newData.child('comment').val().length <= 500))"
        }
      }
    },

    "promotions": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    }
  }
}
